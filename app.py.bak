def generateOTP() : 
    digits = "0123456789"
    OTP = "" 
    for i in range(5) : 
        OTP += digits[math.floor(random.random() * 10)] 
    return OTP 

@app.route('/register', methods=['GET', 'POST'])
def register():
    if request.method == 'POST':
        name = request.form['name']
        email = request.form['email']
        password = request.form['password']
        user_type = request.form['user_type']
	
        
        # Store registration data in session
        session['tempName'] = name
        session['tempEmail'] = email
        session['tempPassword'] = password
        session['tempUT'] = user_type
	

        
        # Generate and send OTP
        sesOTP = generateOTP()
        session['tempOTP'] = sesOTP
        
        try:
            msg1 = Message('MyProctor.ai - OTP Verification', sender=sender, recipients=[email])
            msg1.body = f"New Account opening - Your OTP Verification code is {sesOTP}."
            mail.send(msg1)
            
            flash('Registration successful! Please check your email for OTP verification.',  'success')
            return redirect(url_for('verifyEmail'))
        except Exception as e:
            flash('Error sending email. Please try again.', 'error')
            return render_template('register.html')
    
    return render_template('register.html')

