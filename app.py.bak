@app.route('/myidentity', methods=['GET', 'POST'])
def myidentity():
    if request.method == 'POST':
        image_data = request.form['image_hidden']
        
        if image_data:
            # Decode and check image clarity
            try:
                img_bytes = base64.b64decode(image_data)
                np_arr = np.frombuffer(img_bytes, np.uint8)
                image_cv = cv2.imdecode(np_arr, cv2.IMREAD_COLOR)

                if image_cv is None:
                    flash('Invalid image format. Please recapture your image.', 'error')
                    return render_template('verifyImage.html')

                if is_image_blurry(image_cv, threshold=120):
                    flash('Image is blurry. Please capture a clearer photo.', 'error')
                    return render_template('verifyImage.html')

            except Exception as e:
                print(f"ERROR: Failed to process image: {e}")
                flash('Error processing image. Please try again.', 'error')
                return render_template('verifyImage.html')

            # Store image data in session
            session['tempImage'] = image_data

            # Complete registration
            name = session.get('tempName')
            email = session.get('tempEmail')
            password = session.get('tempPassword')
            user_type = session.get('tempUT')
            
            try:
                cursor = mysql.connection.cursor()
                print(f"Connection established")

                cursor.execute("""
                    INSERT INTO users (name, email, password, user_type, user_image, user_login) 
                    VALUES (%s, %s, %s, %s, %s, %s)
                """, (name, email, password, user_type, image_data, 0))

                mysql.connection.commit()
                cursor.close()

                session.pop('tempName', None)
                session.pop('tempEmail', None)
                session.pop('tempPassword', None)
                session.pop('tempUT', None)
                session.pop('tempOTP', None)
                session.pop('tempImage', None)

                flash('Registration completed successfully! You can now login.', 'success')
                return redirect(url_for('login'))

            except Exception as e:
                print(f"ERROR: Exception during registration: {e}")
                flash('Error completing registration. Please try again.', 'error')
                return render_template('verifyImage.html')

        else:
            flash('Please capture your image for identity verification.', 'error')

    return render_template('verifyImage.html')


def is_image_blurry(image, threshold=100):
    """
    Checks if the image is blurry using the Laplacian variance method.
    A lower threshold value makes the check stricter.
    """
    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
    variance = cv2.Laplacian(gray, cv2.CV_64F).var()
    return variance < threshold

@app.route('/login', methods=['GET', 'POST'])
def login():
    if request.method == 'POST':
        email = request.form['email']
        password = request.form['password']
        
        try:
            # conn = mysql.get_db()
            cursor = mysql.connection.cursor()
            print(f"connection establish")
            
            args = cursor.execute("SELECT * FROM users WHERE email = %s AND password = %s", (email, password))
            user = cursor.fetchone()
            cursor.close()
            print(user)
            print(args)
            
            
            if args > 0:
                # Store user data in session for identity verification
                session['login_user_id'] = user['uid']
                session['login_user_name'] = user['name']
                session['login_user_email'] = user['email']
                session['login_user_type'] = user['user_type']
                session['stored_image'] = user['user_image']
                
                flash('Login credentials verified! Please complete identity verification.', 'success')
                return redirect(url_for('identityVerify'))
            else:
                flash('Invalid email or password.', 'error')
                
        except Exception as e:
            print(f"ERROR: Exception occurred during registration: {e}")
            flash('Error during login. Please try again.', 'error')
            
            
    return render_template('login.html')

@app.route('/identityVerify', methods=['GET', 'POST'])
def identityVerify():
    if request.method == 'POST':
        cursor = mysql.connection.cursor()
        uid = session.get("login_user_id")
        cursor.execute("SELECT * FROM users WHERE uid = %s", (uid,))
        user = cursor.fetchone()
        cursor.close()
        print(user)
        
        captured_image = request.form['image_hidden']
        stored_image = user['user_image']
        
        if not captured_image:
            flash('Please capture your image for identity verification.', 'error')
            return render_template('identity-verify.html')
        
        try:
            captured_img_data = base64.b64decode(captured_image)
            stored_img_data = base64.b64decode(stored_image)
            
            captured_np = np.frombuffer(captured_img_data, np.uint8)
            stored_np = np.frombuffer(stored_img_data, np.uint8)
            
            captured_cv_color = cv2.imdecode(captured_np, cv2.IMREAD_COLOR)
            stored_cv = cv2.imdecode(stored_np, cv2.IMREAD_COLOR)
            
            # Check if captured image is blurry
            if is_image_blurry(captured_cv_color, threshold=120):
                flash('Captured image is blurry. Please retake a clearer photo.', 'error')
                return render_template('identity-verify.html')

            # Convert to grayscale for DeepFace
            captured_cv_gray = cv2.cvtColor(captured_cv_color, cv2.COLOR_BGR2GRAY)
            stored_cv_gray = cv2.cvtColor(stored_cv, cv2.COLOR_BGR2GRAY)

            # Perform face verification
            result = DeepFace.verify(captured_cv_gray, stored_cv_gray, enforce_detection=True)
            print(result)
            
            if result['verified']:
                session['logged_in'] = True
                session['uid'] = session.get('login_user_id')
                session['name'] = session.get('login_user_name')
                session['email'] = session.get('login_user_email')
                session['user_role'] = session.get('login_user_type')
                
                session.pop('login_user_id', None)
                session.pop('login_user_name', None)
                session.pop('login_user_email', None)
                session.pop('login_user_type', None)
                session.pop('stored_image', None)
                
                if session['user_role'] == 'student':
                    return redirect(url_for('student_index'))
                else:
                    return redirect(url_for('professor_index'))
            else:
                flash('Identity verification failed. Please try again.', 'error')
                
        except Exception as e:
            print(e)
            flash('Error during identity verification. Please try again.', 'error')
    
    return render_template('identity-verify.html')




